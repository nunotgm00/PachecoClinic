@model PachecoClinic.Data.Entities.Specialty

@{
    ViewData["Title"] = "Specialty Details";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Specialty Details
                    </h2>

                    <p class="text-muted mb-0">
                        View the veterinary specialty information.
                    </p>

                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-3 mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <dl class="row mb-0">

                    <dt class="col-sm-4 fw-semibold">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                </dl>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary rounded-3 px-4">
                            <i class="bi bi-pencil me-1"></i>
                            Edit Specialty
                        </a>
                    }

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 px-4">
                        Back to Specialties
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>