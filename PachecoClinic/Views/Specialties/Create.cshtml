@model PachecoClinic.Data.Entities.Specialty

@{
    ViewData["Title"] = "Create Specialty";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Create Specialty
                    </h2>

                    <p class="text-muted mb-0">
                        Register a new veterinary specialty in the clinic.
                    </p>

                </div>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control rounded-3"
                               placeholder="Enter the specialty name..." />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary rounded-3 px-4">
                            <i class="bi bi-plus-circle me-1"></i>
                            Create Specialty
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}