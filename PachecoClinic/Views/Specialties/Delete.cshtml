@model PachecoClinic.Data.Entities.Specialty

@{
    ViewData["Title"] = "Delete Specialty";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Delete Specialty
                    </h2>

                    <p class="text-danger mb-0">
                        Are you sure you want to delete this specialty?
                    </p>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-4 fw-semibold">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                </dl>

                <hr class="my-4" />

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-danger rounded-3 px-4">
                            <i class="bi bi-trash me-1"></i>
                            Delete Specialty
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>