@model PachecoClinic.Data.Entities.Specialty

@{
    ViewData["Title"] = "Delete Specialty";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">Delete Specialty</h2>

                <div class="alert alert-danger mb-4">
                    Are you sure you want to delete this specialty?
                </div>

                <dl class="row mb-4">

                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                </dl>

                <form asp-action="Delete" method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Specialty
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>