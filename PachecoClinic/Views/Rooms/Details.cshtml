@model PachecoClinic.Data.Entities.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">Room Details</h2>

                <dl class="row mb-4">

                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4">
                        Type
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Type
                    </dd>

                    <dt class="col-sm-4">
                        Under Maintenance
                    </dt>

                    <dd class="col-sm-8">
                        @if (Model.UnderMaintenance)
                        {
                            <span class="badge bg-warning text-dark">
                                Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                No
                            </span>
                        }
                    </dd>

                </dl>

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit Room
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Rooms
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>