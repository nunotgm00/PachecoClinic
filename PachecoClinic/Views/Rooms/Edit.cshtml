@model PachecoClinic.Data.Entities.Room

@{
    ViewData["Title"] = "Edit Room";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">Edit Room</h2>

                <form asp-action="Edit" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="Id" />


                    <div class="mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Type"
                               class="form-label">
                            Type
                        </label>

                        <input asp-for="Type"
                               class="form-control" />

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="form-check mb-4">

                        <input asp-for="UnderMaintenance"
                               class="form-check-input" />

                        <label asp-for="UnderMaintenance"
                               class="form-check-label">
                            Under Maintenance
                        </label>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}