@model PachecoClinic.Data.Entities.Room

@{
    ViewData["Title"] = "Create Room";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-2">Create Room</h2>

                <p class="text-muted mb-4">
                    Add a new room to the clinic.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Type"
                               class="form-label">
                            Type
                        </label>

                        <input asp-for="Type"
                               class="form-control" />

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-check mb-4">

                        <input asp-for="UnderMaintenance"
                               class="form-check-input" />

                        <label asp-for="UnderMaintenance"
                               class="form-check-label">
                            Under Maintenance
                        </label>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Create Room
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}