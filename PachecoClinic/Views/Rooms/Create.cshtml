@model PachecoClinic.Data.Entities.Room

@{
    ViewData["Title"] = "Create Room";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Create Room
                    </h2>

                    <p class="text-muted mb-0">
                        Register a new room in the clinic.
                    </p>

                </div>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Type"
                                   class="form-label fw-semibold">
                                Type
                            </label>

                            <input asp-for="Type"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="Type"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12">

                            <div class="form-check form-switch mt-2">

                                <input asp-for="UnderMaintenance"
                                       class="form-check-input" />

                                <label asp-for="UnderMaintenance"
                                       class="form-check-label fw-semibold">
                                    Under Maintenance
                                </label>

                            </div>

                            <small class="text-muted">
                                Rooms under maintenance cannot be assigned to appointments.
                            </small>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary rounded-3 px-4">
                            <i class="bi bi-plus-circle me-1"></i>
                            Create Room
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}