@model PachecoClinic.Data.Entities.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <h2>Delete Room</h2>

                    <p class="text-danger mb-0">
                        Are you sure you want to delete this room?
                    </p>

                </div>

                <dl class="row">

                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4">
                        Type
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Type
                    </dd>

                    <dt class="col-sm-4">
                        Under Maintenance
                    </dt>

                    <dd class="col-sm-8">
                        @if (Model.UnderMaintenance)
                        {
                            <span class="badge bg-warning text-dark">
                                Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                No
                            </span>
                        }
                    </dd>

                </dl>

                <hr />

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Room
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>