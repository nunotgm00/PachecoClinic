@model PachecoClinic.Models.ProfileModelView

@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-8 col-lg-7">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Profile Image"
                             class="rounded-circle shadow-sm mb-3"
                             style="width: 150px; height: 150px; object-fit: cover;" />
                    }

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        My Profile
                    </h2>

                    <p class="text-muted mb-0">
                        Manage your personal information and profile image.
                    </p>

                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3 mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Profile"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="FirstName"
                                   class="form-label fw-semibold">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="LastName"
                                   class="form-label fw-semibold">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="LastName"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12">

                            <label asp-for="PhoneNumber"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="col-12">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">
                                Profile Image
                            </label>

                            <input asp-for="ImageFile"
                                   class="form-control rounded-3"
                                   type="file"
                                   accept="image/*" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger small">
                            </span>

                            <small class="text-muted">
                                Select a new image to update your profile picture.
                            </small>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary rounded-3 px-4">
                            <i class="bi bi-check-circle me-1"></i>
                            Save Changes
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Back to Home
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}