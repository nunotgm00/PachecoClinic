@model PachecoClinic.Data.Entities.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Detials</h1>

<h4>Appointment</h4>
<hr/>

<dl class="row">
    <dt class="col-sm-2">
        Animal
    </dt>
    <dd class="col-sm-10">
        @Model.Animal.Name
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt>
    <dd class="col-sm-10">
        @Model.Animal.Client.User.FullName
    </dd>

    <dt class="col-sm-2">
        Doctor
    </dt>
    <dd class="col-sm-10">
        @Model.Doctor.User.FullName
    </dd>

    <dt class="col-sm-2">
        Room
    </dt>
    <dd class="col-sm-10">
        @Model.Room.Name
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>
    <dd class="col-sm-10">
        @Model.Date.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        Start Time
    </dt>
    <dd class="col-sm-10">
        @Model.StartTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        End Time
    </dt>
    <dd class="col-sm-10">
        @Model.EndTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        Motive
    </dt>
    <dd class="col-sm-10">
        @Model.Motive
    </dd>

    <dt class="col-sm-2">
        Status
    </dt>
    <dd class="col-sm-10">
        @Model.Status
    </dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id">Edit</a>

    <span> | </span>

    <a asp-action="Index">Back to List</a>
</div>
