@using PachecoClinic.Data.Entities
@model PachecoClinic.Data.Entities.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h1>Details</h1>

<h4>Appointment</h4>
<hr/>

<dl class="row">
    <dt class="col-sm-2">
        Animal
    </dt>
    <dd class="col-sm-10">
        @Model.Animal.Name
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt>
    <dd class="col-sm-10">
        @Model.Animal.Client.User.FullName
    </dd>

    <dt class="col-sm-2">
        Doctor
    </dt>
    <dd class="col-sm-10">
        @Model.Doctor.User.FullName
    </dd>

    <dt class="col-sm-2">
        Room
    </dt>
    <dd class="col-sm-10">
        @Model.Room.Name
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>
    <dd class="col-sm-10">
        @Model.Date.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        Start Time
    </dt>
    <dd class="col-sm-10">
        @Model.StartTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        End Time
    </dt>
    <dd class="col-sm-10">
        @Model.EndTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        Motive
    </dt>
    <dd class="col-sm-10">
        @Model.Motive
    </dd>

    <dt class="col-sm-2">
        Status
    </dt>
    <dd class="col-sm-10">
        @Model.Status
    </dd>
</dl>

<div>
    @if (User.IsInRole("Client"))
    {
        @if(Model.Status == AppointmentStatus.Scheduled && Model.Date.Date + Model.StartTime > DateTime.Now)
        {
            <a asp-controller="AppointmentRequests"
                asp-action="Create"
                asp-route-appointmentId="@Model.Id"
                class="btn btn-primary">
                Request Change
            </a>
        }

        <a asp-action="MyAppointments"
            class="btn btn-secondary">
            Back to my appointments
        </a>
    }
    else
    {
        <a asp-action="Edit"
            asp-route-id="@Model.Id"
            class="btn btn-primary">
            Edit
        </a>

        @if (Model.Status == AppointmentStatus.Scheduled && Model.Date.Date + Model.StartTime > DateTime.Now)
        {
            <a asp-action="Cancel"
                asp-route-id="@Model.Id"
                class="btn btn-danger">
                Cancel
            </a>
        }

        @if (User.IsInRole("Doctor"))
        {
            @if (Model.Intervention == null)
            {
                <a asp-controller="Interventions"
                   asp-action"Create"
                   asp-route-appointmentId="@Model.Id"
                   class="btn btn-success">
                    Add Intervention
                </a>
            }
            else
            {
                <a asp-controller="Interventions"
                   asp-action="Details"
                   asp-route-id="@Model.Intervention.Id"
                   class="btn btn-info">
                    View Intervention
                </a>
            }
        }
        else if(Model.Intervention != null)
        {
            <a asp-controller="Interventions"
               asp-action="Details"
               asp-route-id="@Model.Intervention.Id"
               class="btn btn-info">
                View Intervention
            </a>
        }

        <a asp-action="Index"
            class="btn btn-secondary">
            Back to list
        </a>
    }
</div>
