@using PachecoClinic.Data.Entities
@model PachecoClinic.Data.Entities.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">
                    Appointment Details
                </h2>

                <dl class="row">

                    <dt class="col-sm-4">
                        Animal
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Animal.Name
                    </dd>


                    <dt class="col-sm-4">
                        Owner
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Animal.Client.User.FullName
                    </dd>


                    <dt class="col-sm-4">
                        Doctor
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Doctor.User.FullName
                    </dd>


                    <dt class="col-sm-4">
                        Room
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Room.Name
                    </dd>


                    <dt class="col-sm-4">
                        Date
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Date.ToString("dd/MM/yyyy")
                    </dd>


                    <dt class="col-sm-4">
                        Start Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.StartTime.ToString(@"hh\:mm")
                    </dd>


                    <dt class="col-sm-4">
                        End Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.EndTime.ToString(@"hh\:mm")
                    </dd>


                    <dt class="col-sm-4">
                        Motive
                    </dt>

                    <dd class="col-sm-8 text-break">
                        @Model.Motive
                    </dd>


                    <dt class="col-sm-4">
                        Status
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else if (Model.Status == AppointmentStatus.Cancelled)
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">
                                Scheduled
                            </span>
                        }

                    </dd>

                </dl>

                <hr />

                <div class="d-flex flex-wrap gap-2">

                    @if (User.IsInRole("Client"))
                    {
                        @if (Model.Status == AppointmentStatus.Scheduled && Model.Date.Date + Model.StartTime > DateTime.Now)
                        {
                            <a asp-controller="AppointmentRequests"
                               asp-action="Create"
                               asp-route-appointmentId="@Model.Id"
                               class="btn btn-primary">
                                Request Change
                            </a>
                        }

                        <a asp-action="MyAppointments"
                           class="btn btn-outline-secondary">
                            Back to My Appointments
                        </a>
                    }
                    else
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit
                        </a>

                        @if (Model.Status == AppointmentStatus.Scheduled && Model.Date.Date + Model.StartTime > DateTime.Now)
                        {
                            <a asp-action="Cancel"
                               asp-route-id="@Model.Id"
                               class="btn btn-danger">
                                Cancel
                            </a>
                        }

                        @if (User.IsInRole("Doctor") && Model.Doctor.User.Email == User.Identity!.Name)
                        {
                            @if (Model.Intervention == null && Model.Status != AppointmentStatus.Cancelled)
                            {
                                <a asp-controller="Interventions"
                                   asp-action="Create"
                                   asp-route-appointmentId="@Model.Id"
                                   class="btn btn-success">
                                    Add Intervention
                                </a>
                            }
                            else if (Model.Intervention != null)
                            {
                                <a asp-controller="Interventions"
                                   asp-action="Details"
                                   asp-route-id="@Model.Intervention.Id"
                                   class="btn btn-info">
                                    View Intervention
                                </a>
                            }

                            @if (Model.Status == AppointmentStatus.Scheduled && Model.Date.Date + Model.StartTime <= DateTime.Now)
                            {
                                <form asp-action="Complete"
                                      asp-route-id="@Model.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-success">
                                        Mark as Completed
                                    </button>

                                </form>
                            }
                        }
                        else if (Model.Intervention != null)
                        {
                            <a asp-controller="Interventions"
                               asp-action="Details"
                               asp-route-id="@Model.Intervention.Id"
                               class="btn btn-info">
                                View Intervention
                            </a>
                        }

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to List
                        </a>
                    }

                </div>

            </div>
        </div>

    </div>
</div>