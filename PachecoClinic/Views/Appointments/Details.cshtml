@using PachecoClinic.Data.Entities
@model PachecoClinic.Data.Entities.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1"
                        style="color: var(--clinic-primary);">
                        Appointment Details
                    </h2>

                    <p class="text-muted mb-0">
                        View the appointment information and available actions.
                    </p>
                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-4 fw-semibold">
                        Animal
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Animal.Name
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Owner
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Animal.Client.User.FullName
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Doctor
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Doctor.User.FullName
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Room
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Room.Name
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Date
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Date.ToString("dd/MM/yyyy")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Start Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.StartTime.ToString(@"hh\:mm")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        End Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.EndTime.ToString(@"hh\:mm")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Motive
                    </dt>

                    <dd class="col-sm-8 text-break">
                        @Model.Motive
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Status
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else if (Model.Status == AppointmentStatus.Cancelled)
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge"
                                  style="background-color: var(--clinic-primary);">
                                Scheduled
                            </span>
                        }

                    </dd>

                </dl>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">

                    @if (User.IsInRole("Client"))
                    {
                        @if (Model.Status == AppointmentStatus.Scheduled &&
                                            Model.Date.Date + Model.StartTime > DateTime.Now)
                        {
                            <a asp-controller="AppointmentRequests"
                               asp-action="Create"
                               asp-route-appointmentId="@Model.Id"
                               class="btn btn-primary rounded-3">
                                <i class="bi bi-arrow-repeat me-1"></i>
                                Request Change
                            </a>
                        }

                        <a asp-action="MyAppointments"
                           class="btn btn-outline-secondary rounded-3">
                            Back to My Appointments
                        </a>
                    }
                    else
                    {
                       
                        @if (Model.Status == AppointmentStatus.Scheduled &&
                                            Model.Date.Date + Model.StartTime > DateTime.Now)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-primary rounded-3">
                                Edit
                            </a>

                            <a asp-action="Cancel"
                               asp-route-id="@Model.Id"
                               class="btn btn-danger rounded-3">
                                Cancel
                            </a>
                        }

                        @if (User.IsInRole("Doctor") &&
                                            Model.Doctor.User.Email == User.Identity!.Name)
                        {
                            @if (Model.Intervention == null &&
                                                Model.Status != AppointmentStatus.Cancelled)
                            {
                                <a asp-controller="Interventions"
                                   asp-action="Create"
                                   asp-route-appointmentId="@Model.Id"
                                   class="btn btn-success rounded-3">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Add Intervention
                                </a>
                            }
                            else if (Model.Intervention != null)
                            {
                                <a asp-controller="Interventions"
                                   asp-action="Details"
                                   asp-route-id="@Model.Intervention.Id"
                                   class="btn btn-outline-primary rounded-3">
                                    View Intervention
                                </a>
                            }

                            @if (Model.Status == AppointmentStatus.Scheduled &&
                                                Model.Date.Date + Model.StartTime <= DateTime.Now)
                            {
                                <form asp-action="Complete"
                                      asp-route-id="@Model.Id"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-success rounded-3">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Mark as Completed
                                    </button>

                                </form>
                            }
                        }
                        else if (Model.Intervention != null)
                        {
                            <a asp-controller="Interventions"
                               asp-action="Details"
                               asp-route-id="@Model.Intervention.Id"
                               class="btn btn-outline-primary rounded-3">
                                View Intervention
                            </a>
                        }

                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-3">
                            Back to List
                        </a>
                    }

                </div>

            </div>
        </div>

    </div>
</div>