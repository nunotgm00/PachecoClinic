@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="row justify-content-center">
    <div class="col-lg-11">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">
                    My Appointments
                </h2>

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Animal</th>
                                <th>Doctor</th>
                                <th>Room</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Motive</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (Appointment item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Animal.Name
                                    </td>

                                    <td>
                                        @item.Doctor.User.FullName
                                    </td>

                                    <td>
                                        @item.Room.Name
                                    </td>

                                    <td>
                                        @item.Date.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                    </td>

                                    <td>

                                        <ejs-tooltip id="motiveTooltip-@item.Id"
                                                     content="@item.Motive"
                                                     OpensOn="Click"
                                                     isSticky="true"
                                                     width="300px"
                                                     position="TopCenter">

                                            <e-content-template>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    View Motive
                                                </button>

                                            </e-content-template>

                                        </ejs-tooltip>

                                    </td>

                                    <td>

                                        @if (item.Status == AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (item.Status == AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        @if (item.Status == AppointmentStatus.Scheduled &&
                                                                            item.Date.Date + item.StartTime > DateTime.Now)
                                        {
                                            <a asp-controller="AppointmentRequests"
                                               asp-action="Create"
                                               asp-route-appointmentId="@item.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Request Change
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

    </div>
</div>