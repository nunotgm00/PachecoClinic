@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}


<h1>My Appointments</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Animal
            </th>

            <th>
                Doctor
            </th>

            <th>
                Room
            </th>

            <th>
                Date
            </th>

            <th>
                Time
            </th>

            <th>
                Motive
            </th>

            <th>
                Status
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (Appointment item in Model)
        {
            <tr>
                <td>
                    @item.Animal.Name
                </td>

                <td>
                    @item.Doctor.User.FullName
                </td>

                <td>
                    @item.Room.Name
                </td>

                <td>
                    @item.Date.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @item.StartTime.ToString(@"hh\:mm")
                    -
                    @item.EndTime.ToString(@"hh\:mm")
                </td>

                <td>
                    @item.Motive
                </td>

                <td>
                    @item.Status
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                        class="btn btn-info">
                        Details
                    </a>

                    @if (item.Status == AppointmentStatus.Scheduled && 
                         item.Date.Date + item.StartTime > DateTime.Now)
                    {
                        <a asp-controller="AppointmentRequests"
                           asp-action="Create"
                           asp-route-apppointmentId="@item.Id"
                           class="btn btn-primary">
                          Request Change
                       </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
