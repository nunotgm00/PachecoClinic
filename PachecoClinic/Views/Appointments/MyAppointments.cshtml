@model IEnumerable<PachecoClinic.Models.MyAppointmentListViewModel>

@{
    ViewData["Title"] = "My Appointments";
}

<style>
    #MyAppointmentsGrid .e-headercell {
        position: relative;
    }

        #MyAppointmentsGrid .e-headercell .e-filtermenudiv {
            position: absolute !important;
            left: 10px !important;
            right: auto !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        #MyAppointmentsGrid .e-headercell:has(.e-filtermenudiv) .e-headercelldiv {
            padding-left: 28px !important;
            margin: 0 !important;
        }

    #MyAppointmentsGrid .e-row:nth-child(even) .e-rowcell {
        background-color: #eef4f4;
    }

    #MyAppointmentsGrid .e-row:hover .e-rowcell {
        background-color: #e3eeee;
    }
</style>

<div class="row justify-content-center mb-5">
    <div class="col-lg-11">

        <div class="mb-4">

            <h2 class="fw-bold mb-1"
                style="color: var(--clinic-primary);">
                My Appointments
            </h2>

            <p class="text-muted mb-0">
                View your appointments and request changes when necessary.
            </p>

        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-3">

                <ejs-grid id="MyAppointmentsGrid"
                          dataSource="@Model"
                          allowSorting="true"
                          allowFiltering="true"
                          allowPaging="true">

                    <e-grid-filtersettings type="Menu">
                    </e-grid-filtersettings>

                    <e-grid-pagesettings pageSize="10">
                    </e-grid-pagesettings>

                    <e-grid-columns>

                        <e-grid-column field="Animal"
                                       headerText="Animal"
                                       width="130">
                        </e-grid-column>

                        <e-grid-column field="Doctor"
                                       headerText="Doctor"
                                       width="170">
                        </e-grid-column>

                        <e-grid-column field="Room"
                                       headerText="Room"
                                       width="150">
                        </e-grid-column>

                        <e-grid-column field="Date"
                                       headerText="Date"
                                       type="date"
                                       format="dd/MM/yyyy"
                                       width="130">
                        </e-grid-column>

                        <e-grid-column field="Time"
                                       headerText="Time"
                                       width="150">
                        </e-grid-column>

                        <e-grid-column field="Status"
                                       headerText="Status"
                                       template="#statusTemplate"
                                       width="130">
                        </e-grid-column>

                        <e-grid-column headerText="Actions"
                                       template="#actionsTemplate"
                                       allowFiltering="false"
                                       allowSorting="false"
                                       textAlign="Left"
                                       width="260">
                        </e-grid-column>

                    </e-grid-columns>

                </ejs-grid>

            </div>
        </div>

    </div>
</div>

<script id="statusTemplate"
        type="text/x-template">

    ${if(Status == "Scheduled")}
        <span class="badge"
              style="background-color: var(--clinic-primary);">
            Scheduled
        </span>
    ${else if(Status == "Completed")}
        <span class="badge bg-success">
            Completed
        </span>
    ${else}
        <span class="badge bg-danger">
            Cancelled
        </span>
    ${/if}

</script>

<script id="actionsTemplate"
        type="text/x-template">

    <div class="d-flex gap-2">

        <a href="/Appointments/Details/${Id}"
           class="btn btn-sm btn-outline-primary rounded-3">
            Details
        </a>

        ${if(CanRequestChange)}

            <a href="/AppointmentRequests/Create?appointmentId=${Id}"
               class="btn btn-sm btn-outline-secondary rounded-3">
                Request Change
            </a>

        ${else if(HasPendingRequest)}

            <span class="badge bg-warning text-dark align-self-center px-3 py-2 rounder-3">
                Request Pending
            </span>

        ${/if}

    </div>

</script>