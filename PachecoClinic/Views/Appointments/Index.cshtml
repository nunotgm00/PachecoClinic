@model IEnumerable<PachecoClinic.Models.AppointmentListViewModel>

@{
    ViewData["Title"] = "Appointments";
}

<style>
    #AppointmentsGrid .e-headercell {
        position: relative;
    }

        #AppointmentsGrid .e-headercell .e-filtermenudiv {
            position: absolute !important;
            left: 10px !important;
            right: auto !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        #AppointmentsGrid .e-headercell:has(.e-filtermenudiv) .e-headercelldiv {
            padding-left: 28px !important;
            margin: 0 !important;
        }

    #AppointmentsGrid .e-row:nth-child(even) .e-rowcell {
        background-color: #eef4f4;
    }

    #AppointmentsGrid .e-row:hover .e-rowcell {
        background-color: #e3eeee;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1"
            style="color: var(--clinic-primary);">
            Appointments
        </h1>

        <p class="text-muted mb-0">
            View and manage clinic appointments.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary rounded-3 px-3">
        <i class="bi bi-calendar-plus me-1"></i>
        Create Appointment
    </a>

</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5"
     style="border-top: 5px solid var(--clinic-primary) !important;">

    <div class="card-body p-3">

        <ejs-grid id="AppointmentsGrid"
                  dataSource="@Model"
                  allowSorting="true"
                  allowFiltering="true"
                  allowPaging="true">

            <e-grid-filtersettings type="Menu">
            </e-grid-filtersettings>

            <e-grid-pagesettings pageSize="10">
            </e-grid-pagesettings>

            <e-grid-columns>

                <e-grid-column field="Animal"
                               headerText="Animal"
                               width="120">
                </e-grid-column>

                <e-grid-column field="Owner"
                               headerText="Owner"
                               width="170">
                </e-grid-column>

                <e-grid-column field="Doctor"
                               headerText="Doctor"
                               width="150">
                </e-grid-column>

                <e-grid-column field="Room"
                               headerText="Room"
                               width="110">
                </e-grid-column>

                <e-grid-column field="Date"
                               headerText="Date"
                               type="date"
                               format="dd/MM/yyyy"
                               width="120">
                </e-grid-column>

                <e-grid-column field="Time"
                               headerText="Time"
                               width="140">
                </e-grid-column>

                <e-grid-column field="Status"
                               headerText="Status"
                               template="#statusTemplate"
                               width="120">
                </e-grid-column>

                <e-grid-column headerText="Actions"
                               template="#actionsTemplate"
                               allowFiltering="false"
                               allowSorting="false"
                               textAlign="Center"
                               width="240">
                </e-grid-column>

            </e-grid-columns>

        </ejs-grid>

    </div>

</div>

<script id="statusTemplate"
        type="text/x-template">

    ${if(Status == "Scheduled")}
        <span class="badge"
              style="background-color: var(--clinic-primary);">
            Scheduled
        </span>

    ${else if(Status == "Completed")}
        <span class="badge bg-success">
            Completed
        </span>

    ${else}
        <span class="badge bg-danger">
            Cancelled
        </span>
    ${/if}

</script>

<script id="actionsTemplate"
        type="text/x-template">

    <div class="d-flex justify-content-center gap-2">

        <a href="/Appointments/Details/${Id}"
           class="btn btn-sm btn-outline-primary rounded-3">
            Details
        </a>

        ${if(CanManage)}

            <a href="/Appointments/Edit/${Id}"
               class="btn btn-sm btn-outline-secondary rounded-3">
                Edit
            </a>

            <a href="/Appointments/Cancel/${Id}"
               class="btn btn-sm btn-outline-danger rounded-3">
                Cancel
            </a>

        ${else}

            <span class="btn btn-sm btn-outline-secondary rounded-3 invisible">
                Edit
            </span>

            <span class="btn btn-sm btn-outline-danger rounded-3 invisible">
                Cancel
            </span>

        ${/if}

    </div>

</script>

