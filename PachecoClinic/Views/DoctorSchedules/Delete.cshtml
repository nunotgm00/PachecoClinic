@model PachecoClinic.Data.Entities.DoctorSchedule

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this schedule?</h3>

<dl class="row">
    <dt class="col-sm-2">
        Doctor
    </dt>

    <dd class="col-sm10">
        @Model.Doctor.User.FullName
    </dd>

    <dt class="col-sm-2">
        Day
    </dt>

    <dd class="col-sm10">
        @Model.DayOfWeek
    </dd>

    <dt class="col-sm-2">
        Start Time
    </dt>

    <dd class="col-sm10">
        @Model.StartTime
    </dd>

    <dt class="col-sm-2">
        End Time
    </dt>

    <dd class="col-sm10">
        @Model.EndTime
    </dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id"/>

    <input type="submit" value="Delete" class="btn btn-danger"/>

    <a asp-action="Index">Back to list</a>
</form>