@model PachecoClinic.Models.DoctorScheduleViewModel

@{
    ViewData["Title"] = "Doctor Schedule";

    DateTime today = DateTime.Today;
    int daysSinceMonday = ((int)today.DayOfWeek + 6) % 7;
    DateTime monday = today.AddDays(-daysSinceMonday);

    string[] dayNames =
    {
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="mb-4">
                    <h2 class="mb-1">Doctor Schedule</h2>
                    <p class="text-muted mb-0">@Model.DoctorName</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Manage" method="post" id="scheduleForm">

                    <input type="hidden" asp-for="DoctorId" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    @for (int i = 0; i < Model.Days.Count; i++)
                    {
                        <input type="hidden" asp-for="Days[i].DayOfWeek" />

                        <input type="hidden"
                               asp-for="Days[i].StartTime"
                               id="startTime-@i" />

                        <input type="hidden"
                               asp-for="Days[i].EndTime"
                               id="endTime-@i" />
                    }


                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Week
                        </label>

                        <div class="d-flex gap-2 overflow-auto pb-2">

                            @for (int i = 0; i < 7; i++)
                            {
                                DateTime date = monday.AddDays(i);

                                <button type="button"
                                        id="dayButton-@i"
                                        class="btn btn-outline-secondary flex-fill py-3"
                                        style="min-width: 105px;"
                                        onclick="selectDay(@i)">

                                    <div class="fw-semibold">
                                        @dayNames[i]
                                    </div>

                                    <small>
                                        @date.ToString("dd/MM")
                                    </small>

                                    <div class="small mt-1"
                                         id="daySummary-@i">
                                    </div>

                                </button>
                            }

                        </div>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>
                            <h4 class="mb-1"
                                id="selectedDayName">
                                Monday
                            </h4>

                            <span class="text-muted"
                                  id="dayStatus">
                            </span>
                        </div>

                        <button type="button"
                                class="btn btn-outline-danger"
                                onclick="setDayOff()">
                            Day Off
                        </button>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Start Time
                            </label>

                            <ejs-timepicker id="startTimePicker"
                                            placeholder="Select start time"
                                            format="HH:mm"
                                            step="15"
                                            change="timeChanged">
                            </ejs-timepicker>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                End Time
                            </label>

                            <ejs-timepicker id="endTimePicker"
                                            placeholder="Select end time"
                                            format="HH:mm"
                                            step="15"
                                            change="timeChanged">
                            </ejs-timepicker>

                        </div>

                    </div>


                    <div class="d-flex justify-content-between mt-4">

                        <a asp-controller="Doctors"
                           asp-action="Details"
                           asp-route-id="@Model.DoctorId"
                           class="btn btn-outline-secondary">
                            Back to Doctor
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Schedule
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>


<script>

    var selectedDayIndex = 0;
    var loadingDay = false;


    window.addEventListener("load", function () {

        updateAllDaySummaries();

        selectDay(0);

        document.getElementById("scheduleForm")
            .addEventListener("submit", function () {

                saveSelectedDay();
            });
    });


    function selectDay(index) {

        saveSelectedDay();

        selectedDayIndex = index;

        updateDayButtons();

        loadSelectedDay();
    }


    function loadSelectedDay() {

        loadingDay = true;

        var startValue =
            document.getElementById("startTime-" + selectedDayIndex).value;

        var endValue =
            document.getElementById("endTime-" + selectedDayIndex).value;


        var startPicker =
            document.getElementById("startTimePicker").ej2_instances[0];

        var endPicker =
            document.getElementById("endTimePicker").ej2_instances[0];


        startPicker.value =
            startValue ? parseTime(startValue) : null;

        endPicker.value =
            endValue ? parseTime(endValue) : null;


        startPicker.dataBind();
        endPicker.dataBind();


        document.getElementById("selectedDayName").textContent =
            getDayName(selectedDayIndex);


        updateStatus(startValue, endValue);

        loadingDay = false;
    }


    function timeChanged() {

        if (loadingDay) {
            return;
        }

        saveSelectedDay();
    }


    function saveSelectedDay() {

        var startPicker =
            document.getElementById("startTimePicker")?.ej2_instances?.[0];

        var endPicker =
            document.getElementById("endTimePicker")?.ej2_instances?.[0];


        if (!startPicker || !endPicker) {
            return;
        }


        var startValue =
            startPicker.value ? formatTime(startPicker.value) : "";

        var endValue =
            endPicker.value ? formatTime(endPicker.value) : "";


        document.getElementById("startTime-" + selectedDayIndex).value =
            startValue;

        document.getElementById("endTime-" + selectedDayIndex).value =
            endValue;


        updateStatus(startValue, endValue);

        updateDaySummary(selectedDayIndex);
    }


    function setDayOff() {

        var startPicker =
            document.getElementById("startTimePicker").ej2_instances[0];

        var endPicker =
            document.getElementById("endTimePicker").ej2_instances[0];


        loadingDay = true;


        startPicker.value = null;
        endPicker.value = null;

        startPicker.dataBind();
        endPicker.dataBind();


        document.getElementById("startTime-" + selectedDayIndex).value = "";
        document.getElementById("endTime-" + selectedDayIndex).value = "";


        loadingDay = false;


        updateStatus("", "");

        updateDaySummary(selectedDayIndex);
    }


    function updateStatus(startTime, endTime) {

        var status =
            document.getElementById("dayStatus");


        if (!startTime && !endTime) {

            status.textContent = "Day Off";

            return;
        }


        if (startTime && endTime) {

            status.textContent =
                startTime.substring(0, 5) +
                " - " +
                endTime.substring(0, 5);

            return;
        }


        status.textContent = "Incomplete schedule";
    }


    function updateDaySummary(index) {

        var startValue =
            document.getElementById("startTime-" + index).value;

        var endValue =
            document.getElementById("endTime-" + index).value;

        var summary =
            document.getElementById("daySummary-" + index);


        if (!startValue && !endValue) {

            summary.textContent = "Day Off";

            return;
        }


        if (startValue && endValue) {

            summary.textContent =
                startValue.substring(0, 5) +
                " - " +
                endValue.substring(0, 5);

            return;
        }


        summary.textContent = "Incomplete";
    }


    function updateAllDaySummaries() {

        for (var i = 0; i < 7; i++) {

            updateDaySummary(i);
        }
    }


    function updateDayButtons() {

        for (var i = 0; i < 7; i++) {

            var button =
                document.getElementById("dayButton-" + i);


            if (i === selectedDayIndex) {

                button.classList.remove("btn-outline-secondary");
                button.classList.add("btn-primary");
            }
            else {

                button.classList.remove("btn-primary");
                button.classList.add("btn-outline-secondary");
            }
        }
    }


    function parseTime(value) {

        var parts = value.split(":");

        var date = new Date();

        date.setHours(
            parseInt(parts[0]),
            parseInt(parts[1]),
            0,
            0);

        return date;
    }


    function formatTime(date) {

        var hours =
            date.getHours()
                .toString()
                .padStart(2, "0");

        var minutes =
            date.getMinutes()
                .toString()
                .padStart(2, "0");

        return hours + ":" + minutes + ":00";
    }


    function getDayName(index) {

        var days =
        [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
        ];

        return days[index];
    }

</script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}