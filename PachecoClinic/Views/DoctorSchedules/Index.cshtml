@model IEnumerable<PachecoClinic.Data.Entities.DoctorSchedule>

@{
    ViewData["Title"] = "Doctor Schedules";
}

<h1>Doctor Schedules</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Doctor</th>
            <th>Day</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Doctor.User.FullName
                </td>

                <td>
                    @item.DayOfWeek
                </td>

                <td>
                    @item.StartTime
                </td>

                <td>
                    @item.EndTime
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>
