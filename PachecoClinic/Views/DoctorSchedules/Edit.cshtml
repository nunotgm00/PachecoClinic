@model PachecoClinic.Models.DoctorScheduleViewModel

@{
    ViewData["Title"] = "Edit Schedule";
}

<h1>Edit</h1>

<h4>Doctor Schedule</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="DoctorId"></label>

                <select asp-for="DoctorId"
                        asp-items="Model.Doctors"
                        class="form-control">
                </select>

                <span asp-validation-for="DoctorId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DayOfWeek"></label>

                <select asp-for="DayOfWeek"
                        asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                        class="form-control">
                </select>

                <span asp-validation-for="DayOfWeek"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartTime"></label>

                <input asp-for="StartTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="StartTime"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndTime"></label>

                <input asp-for="EndTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="EndTime"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}