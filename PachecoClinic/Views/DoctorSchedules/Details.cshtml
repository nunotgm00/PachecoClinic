@model PachecoClinic.Data.Entities.DoctorSchedule

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<h4>Doctor Schedule</h4>
<hr />

<dl class="row">

    <dt class="col-sm-2">
        Doctor
    </dt>

    <dd class="col-sm-10">
        @Model.Doctor.User.FullName
    </dd>

    <dt class="col-sm-2">
        Day
    </dt>

    <dd class="col-sm-10">
        @Model.DayOfWeek
    </dd>

    <dt class="col-sm-2">
        Start Time
    </dt>

    <dd class="col-sm-10">
        @Model.StartTime
    </dd>

    <dt class="col-sm-2">
        End Time
    </dt>

    <dd class="col-sm-10">
        @Model.EndTime
    </dd>

</dl>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id">Edit</a>

        <span> | </span>
    }

    <a asp-action="Index">Back to List</a>
</div>