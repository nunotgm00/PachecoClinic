@model PachecoClinic.Models.ClinicClosureViewModel

@{
    ViewData["Title"] = "Clinic Closure";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-9 col-lg-7">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Clinic Closure
                    </h2>

                    <p class="text-muted mb-0">
                        Send a closure notification to all clients.
                    </p>

                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-3">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="ClinicClosure" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Date"
                               class="form-label fw-semibold">
                            Closure Date
                        </label>

                        <input asp-for="Date"
                               class="form-control rounded-3" />

                        <span asp-validation-for="Date"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Message"
                               class="form-label fw-semibold">
                            Message
                        </label>

                        <textarea asp-for="Message"
                                  class="form-control rounded-3"
                                  rows="5"
                                  placeholder="Enter the reason for the clinic closure...">
                        </textarea>

                        <span asp-validation-for="Message"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="alert alert-warning rounded-3 mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        This notification will be sent to all registered clients.

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary rounded-3 px-4">
                            <i class="bi bi-send me-1"></i>
                            Send Notification
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">
                            Back to Home
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}