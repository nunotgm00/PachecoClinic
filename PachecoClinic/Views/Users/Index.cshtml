@model IEnumerable<PachecoClinic.Models.UserIndexViewModel>

@{
    ViewData["Title"] = "Users";
}

<style>
    #UsersGrid .e-headercell {
        position: relative;
    }

        #UsersGrid .e-headercell .e-filtermenudiv {
            position: absolute !important;
            left: 10px !important;
            right: auto !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        #UsersGrid .e-headercell:has(.e-filtermenudiv) .e-headercelldiv {
            padding-left: 28px !important;
            margin: 0 !important;
        }

    #UsersGrid .e-row:nth-child(even) .e-rowcell {
        background-color: #eef4f4;
    }

    #UsersGrid .e-row:hover .e-rowcell {
        background-color: #e3eeee;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1"
            style="color: var(--clinic-primary);">
            Users
        </h1>

        <p class="text-muted mb-0">
            View registered users, their roles and registration status.
        </p>

    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
        <a asp-action="Create"
           class="btn btn-primary rounded-3 px-3">
            <i class="bi bi-person-plus me-1"></i>
            Create User
        </a>
    }

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-3 mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger rounded-3 mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5"
     style="border-top: 5px solid var(--clinic-primary) !important;">

    <div class="card-body p-3">

        <ejs-grid id="UsersGrid"
                  dataSource="@Model"
                  allowSorting="true"
                  allowFiltering="true"
                  allowPaging="true">

            <e-grid-filtersettings type="Menu">
            </e-grid-filtersettings>

            <e-grid-pagesettings pageSize="10">
            </e-grid-pagesettings>

            <e-grid-columns>

                <e-grid-column field="FullName"
                               headerText="Name"
                               width="200">
                </e-grid-column>

                <e-grid-column field="Email"
                               headerText="Email"
                               width="260">
                </e-grid-column>

                <e-grid-column field="PhoneNumber"
                               headerText="Phone Number"
                               width="180">
                </e-grid-column>

                <e-grid-column field="Role"
                               headerText="Role"
                               width="140">
                </e-grid-column>

                <e-grid-column field="ProfileCompleted"
                               headerText="Status"
                               type="boolean"
                               template="#statusTemplate"
                               textAlign="Center"
                               width="200">
                </e-grid-column>

            </e-grid-columns>

        </ejs-grid>

    </div>

</div>

<script id="statusTemplate" type="text/x-template">

    ${if(ProfileCompleted)}

        <span class="badge rounded-2 bg-success bg-opacity-10 text-success px-3 py-2">
            Active
        </span>

    ${else}

        <span class="badge rounded-2 bg-warning bg-opacity-25 text-dark px-3 py-2">
            Pending Registration
        </span>

    ${/if}

</script>