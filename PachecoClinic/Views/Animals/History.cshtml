@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.Appointment>

@{
    ViewData["Title"] = "Medical History";
    Animal animal = ViewBag.Animal;
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-11">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">

                    <h2 class="fw-bold mb-1"
                        style="color: var(--clinic-primary);">
                        Medical History
                    </h2>

                    <h5 class="text-muted mb-2">
                        @animal.Name
                    </h5>

                    <p class="mb-0">
                        <strong>Owner:</strong>
                        @animal.Client.User.FullName
                    </p>

                </div>

                <div class="table-responsive rounded-3 border">

                    <table class="table table-hover table-striped align-middle mb-0"
                           style="--bs-table-striped-bg: #eef4f4;">

                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Doctor</th>
                                <th>Room</th>
                                <th>Motive</th>
                                <th>Status</th>
                                <th>Intervention</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (Appointment item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Date.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.StartTime.ToString(@"hh\:mm")
                                        -
                                        @item.EndTime.ToString(@"hh\:mm")
                                    </td>

                                    <td>
                                        @item.Doctor.User.FullName
                                    </td>

                                    <td>
                                        @item.Room.Name
                                    </td>

                                    <td>
                                        <ejs-tooltip id="motiveTooltip-@item.Id"
                                                     content="@item.Motive"
                                                     OpensOn="Click"
                                                     isSticky="true"
                                                     width="300px"
                                                     position="TopCenter">

                                            <e-content-template>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary rounded-3">
                                                    View Motive
                                                </button>

                                            </e-content-template>

                                        </ejs-tooltip>
                                    </td>

                                    <td>
                                        @if (item.Status == AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (item.Status == AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge"
                                                  style="background-color: var(--clinic-primary);">
                                                Scheduled
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Intervention != null)
                                        {
                                            <a asp-controller="Interventions"
                                               asp-action="Details"
                                               asp-route-id="@item.Intervention.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                View
                                            </a>
                                        }
                                        else if (User.IsInRole("Doctor") &&
                                        item.Doctor.User.Email == User.Identity!.Name &&
                                        item.Status != AppointmentStatus.Cancelled)
                                        {
                                            <a asp-controller="Interventions"
                                               asp-action="Create"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success rounded-3">
                                                Add
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not created
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Appointments"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary rounded-3">
                                            Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="mt-4">

                    <a asp-action="Details"
                       asp-route-id="@animal.Id"
                       class="btn btn-outline-secondary rounded-3">
                        Back to Animal
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>