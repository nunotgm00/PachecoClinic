@model PachecoClinic.Models.EditAnimalsViewModel

@{
    ViewData["Title"] = "Edit Animal";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-2">Edit Animal</h2>

                <p class="text-muted mb-4">
                    Update the animal's information.
                </p>

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="Id" />

                    <input type="hidden"
                           asp-for="CurrentImageURL" />


                    <div class="text-center mb-4">

                        <img src="@Model.CurrentImageURL"
                             alt="@Model.Name"
                             class="rounded"
                             style="width: 180px; height: 180px; object-fit: cover;" />

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Species"
                                   class="form-label">
                                Species
                            </label>

                            <input asp-for="Species"
                                   class="form-control" />

                            <span asp-validation-for="Species"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Breed"
                                   class="form-label">
                                Breed
                            </label>

                            <input asp-for="Breed"
                                   class="form-control" />

                            <span asp-validation-for="Breed"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="BirthDate"
                                   class="form-label">
                                Birth Date
                            </label>

                            <input asp-for="BirthDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="BirthDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Weight"
                                   class="form-label">
                                Weight
                            </label>

                            <input asp-for="Weight"
                                   class="form-control" />

                            <span asp-validation-for="Weight"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Color"
                                   class="form-label">
                                Color
                            </label>

                            <input asp-for="Color"
                                   class="form-control" />

                            <span asp-validation-for="Color"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Sex"
                                   class="form-label">
                                Sex
                            </label>

                            <input asp-for="Sex"
                                   class="form-control" />

                            <span asp-validation-for="Sex"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="ClientId"
                                   class="form-label">
                                Owner
                            </label>

                            <select asp-for="ClientId"
                                    asp-items="Model.Clients"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="ClientId"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="mb-4">

                        <label asp-for="ImageFile"
                               class="form-label">
                            Change Image
                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               accept="image/*"
                               class="form-control" />

                        <span asp-validation-for="ImageFile"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}