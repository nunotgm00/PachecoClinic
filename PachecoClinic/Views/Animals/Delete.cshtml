@model PachecoClinic.Data.Entities.Animal

@{
    ViewData["Title"] = "Delete Animal";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">

                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="rounded-3 mb-3 shadow-sm"
                         style="width: 180px; height: 180px; object-fit: cover;" />

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Delete Animal
                    </h2>

                    <p class="text-danger mb-0">
                        Are you sure you want to delete this animal?
                    </p>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 mb-4">
                </div>

                <dl class="row mb-4">

                    <dt class="col-sm-4 fw-semibold">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Species
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Species
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Breed
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Breed) ? "-" : Model.Breed)
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Owner
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Client.User.FullName
                    </dd>

                </dl>

                <hr class="my-4" />

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger px-4 rounded-3">
                            <i class="bi bi-trash me-1"></i>
                            Delete Animal
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary px-4 rounded-3">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>