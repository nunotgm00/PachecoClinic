@model PachecoClinic.Data.Entities.Animal

@{
    ViewData["Title"] = "Delete Animal";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this animal?</h3>

<div asp-validation-summary="ModelOnly"
    class="text-danger"></div>

<div>
    <img src="@Model.ImageUrl"
         alt="@Model.Name"
         style="max-width: 200px; max-height: 200px;"/>
</div>

<hr/>

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>
    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Species
    </dt>

    <dd class="col-sm-10">
        @Model.Species
    </dd>

    <dt class="col-sm-2">
        Breed
    </dt>

    <dd class="col-sm-10">
        @Model.Breed
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt>

    <dd class="col-sm-10">
        @Model.Client.User.FullName
    </dd>

</dl>

<form asp-action="Delete" method="post">
    
    <input type="hidden" asp-for="Id"/>

    <input type="submit" value="Delete" class="btn btn-danger"/>

    <a asp-action="Index">Back to List</a>
</form>
