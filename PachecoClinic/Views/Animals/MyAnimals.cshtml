@model IEnumerable<PachecoClinic.Data.Entities.Animal>

@{
    ViewData["Title"] = "My Animals";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-10">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1"
                        style="color: var(--clinic-primary);">
                        My Animals
                    </h2>

                    <p class="text-muted mb-0">
                        View your registered animals and their medical history.
                    </p>
                </div>

                <div class="table-responsive rounded-3 border">

                    <table class="table table-hover table-striped align-middle mb-0"
                           style="--bs-table-striped-bg: #eef4f4;">

                        <thead class="table-light">
                            <tr>
                                <th>Photo</th>
                                <th>Name</th>
                                <th>Species</th>
                                <th>Breed</th>
                                <th>Birth Date</th>
                                <th>Weight</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             class="rounded-3 shadow-sm"
                                             style="width: 70px; height: 70px; object-fit: cover;" />
                                    </td>

                                    <td>
                                        <strong>
                                            @item.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @item.Species
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(item.Breed) ? "-" : item.Breed)
                                    </td>

                                    <td>
                                        @(item.BirthDate.HasValue? item.BirthDate.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>

                                    <td>
                                        @(item.Weight.HasValue ? $"{item.Weight.Value:0.##} kg" : "-")
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                Details
                                            </a>

                                            <a asp-action="History"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary rounded-3">
                                                Medical History
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

    </div>
</div>