@model PachecoClinic.Data.Entities.Animal

@{
    ViewData["Title"] = "Animal Details";
}

<h1>Details</h1>

<h4>Animal</h4>

<hr />

<div>
    <img src="@Model.ImageUrl"
         alt="@Model.Name"
         style="max-width: 300px; max-height: 300px;"/>
</div>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt
    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Species
    </dt
    <dd class="col-sm-10">
        @Model.Species
    </dd>

    <dt class="col-sm-2">
        Breed
    </dt
    <dd class="col-sm-10">
        @Model.Breed
    </dd>

    <dt class="col-sm-2">
        Birth Date
    </dt
    <dd class="col-sm-10">
        @Model.BirthDate?.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        Weight
    </dt
    <dd class="col-sm-10">
        @Model.Weight
    </dd>

    <dt class="col-sm-2">
        Color
    </dt
    <dd class="col-sm-10">
        @Model.Color
    </dd>

    <dt class="col-sm-2">
        Sex
    </dt
    <dd class="col-sm-10">
        @Model.Sex
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt
    <dd class="col-sm-10">
        @Model.Client.User.FullName
    </dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id">Edit</a>

    <span> | </span>

    <a asp-action="Index">Back to List</a>
</div>