@model PachecoClinic.Data.Entities.Animal

@{
    ViewData["Title"] = "Animal Details";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="row align-items-start">

                    <div class="col-md-5 text-center mb-4 mb-md-0">

                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="rounded img-fluid"
                             style="max-height: 300px; object-fit: cover;" />

                    </div>

                    <div class="col-md-7">

                        <h2 class="mb-4">
                            @Model.Name
                        </h2>

                        <dl class="row">

                            <dt class="col-sm-4">
                                Species
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Species
                            </dd>


                            <dt class="col-sm-4">
                                Breed
                            </dt>

                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.Breed) ? "-" : Model.Breed)
                            </dd>


                            <dt class="col-sm-4">
                                Birth Date
                            </dt>

                            <dd class="col-sm-8">
                                @(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("dd/MM/yyyy") : "-")
                            </dd>


                            <dt class="col-sm-4">
                                Weight
                            </dt>

                            <dd class="col-sm-8">
                                @(Model.Weight.HasValue ? $"{Model.Weight.Value:0.##} kg" : "-")
                            </dd>


                            <dt class="col-sm-4">
                                Color
                            </dt>

                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.Color) ? "-" : Model.Color)
                            </dd>


                            <dt class="col-sm-4">
                                Sex
                            </dt>

                            <dd class="col-sm-8">
                                @(string.IsNullOrEmpty(Model.Sex) ? "-" : Model.Sex)
                            </dd>


                            <dt class="col-sm-4">
                                Owner
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Client.User.FullName
                            </dd>

                        </dl>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">

                    <a asp-action="History"
                       asp-route-id="@Model.Id"
                       class="btn btn-info">
                        Medical History
                    </a>

                    @if (User.IsInRole("Client"))
                    {
                        <a asp-action="MyAnimals"
                           class="btn btn-outline-secondary">
                            Back to My Animals
                        </a>
                    }
                    else
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">
                            Delete
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to List
                        </a>
                    }

                </div>

            </div>
        </div>

    </div>
</div>