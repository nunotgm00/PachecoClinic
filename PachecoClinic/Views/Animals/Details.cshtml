@model PachecoClinic.Data.Entities.Animal

@{
    ViewData["Title"] = "Animal Details";
}

<h1>Details</h1>

<h4>Animal</h4>

<hr />

<div>
    <img src="@Model.ImageUrl"
         alt="@Model.Name"
         style="max-width: 300px; max-height: 300px;"/>
</div>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>
    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Species
    </dt>
    <dd class="col-sm-10">
        @Model.Species
    </dd>

    <dt class="col-sm-2">
        Breed
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Breed))
        {
            @Model.Breed
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-2">
        Birth Date
    </dt>
    <dd class="col-sm-10">
        @if (Model.BirthDate.HasValue)
        {
            @Model.BirthDate.Value.ToString("dd/MM/yyyy")
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-2">
        Weight
    </dt>
    <dd class="col-sm-10">
        @if (Model.Weight.HasValue)
        {
            @($"{Model.Weight.Value:0.##} kg")
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-2">
        Color
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Color))
        {
            @Model.Color
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-2">
        Sex
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Sex))
        {
            @Model.Sex
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt>
    <dd class="col-sm-10">
        @Model.Client.User.FullName
    </dd>
</dl>

<div>
    <a asp-action="History"
       asp-route-id="@Model.Id"
       class="btn btn-info">
        Medical History
   </a>

    @if (User.IsInRole("Client"))
    {
        <a asp-action="MyAnimals"
           class="btn btn-secondary">
            Back to my Animals
        </a>
    }
    else
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
       </a>

        <a asp-action="Delete"
          asp-route-id="@Model.Id"
          class="btn btn-danger">
            Delete
       </a>

       <a asp-action="Index"
          class="btn btn-secondary">
            Back to List
      </a>
    }
</div>