@model IEnumerable<PachecoClinic.Models.AnimalListViewModel>

@{
    ViewData["Title"] = "Animals";
}

<style>
    #AnimalsGrid .e-headercell {
        position: relative;
    }

        #AnimalsGrid .e-headercell .e-filtermenudiv {
            position: absolute !important;
            left: 10px !important;
            right: auto !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        #AnimalsGrid .e-headercell:has(.e-filtermenudiv) .e-headercelldiv {
            padding-left: 28px !important;
            margin: 0 !important;
        }

    #AnimalsGrid .e-row:nth-child(even) .e-rowcell {
        background-color: #eef4f4;
    }

    #AnimalsGrid .e-row:hover .e-rowcell {
        background-color: #e3eeee;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1"
            style="color: var(--clinic-primary);">
            Animals
        </h1>

        <p class="text-muted mb-0">
            Manage the animals registered in the clinic.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary rounded-3 px-3">
        <i class="bi bi-plus-circle me-1"></i>
        Create Animal
    </a>

</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5"
     style="border-top: 5px solid var(--clinic-primary) !important;">

    <div class="card-body p-3">

        <ejs-grid id="AnimalsGrid"
                  dataSource="@Model"
                  allowSorting="true"
                  allowFiltering="true"
                  allowPaging="true">

            <e-grid-filtersettings type="Menu">
            </e-grid-filtersettings>

            <e-grid-pagesettings pageSize="10">
            </e-grid-pagesettings>

            <e-grid-columns>

                <e-grid-column field="Name"
                               headerText="Name"
                               width="130">
                </e-grid-column>

                <e-grid-column field="Species"
                               headerText="Species"
                               width="130">
                </e-grid-column>

                <e-grid-column field="Breed"
                               headerText="Breed"
                               width="140">
                </e-grid-column>

                <e-grid-column field="Owner"
                               headerText="Owner"
                               width="190">
                </e-grid-column>

                <e-grid-column field="BirthDate"
                               headerText="Birth Date"
                               type="date"
                               format="dd/MM/yyyy"
                               width="130">
                </e-grid-column>

                <e-grid-column field="Weight"
                               headerText="Weight (kg)"
                               format="N2"
                               textAlign="Left"
                               width="130">
                </e-grid-column>

                <e-grid-column headerText="Actions"
                               template="#actionsTemplate"
                               allowFiltering="false"
                               allowSorting="false"
                               textAlign="Center"
                               width="240">
                </e-grid-column>

            </e-grid-columns>

        </ejs-grid>

    </div>

</div>

<script id="actionsTemplate"
        type="text/x-template">

    <div class="d-flex justify-content-center gap-2">

        <a href="/Animals/Details/${Id}"
           class="btn btn-sm btn-outline-primary rounded-3">
            Details
        </a>

        <a href="/Animals/Edit/${Id}"
           class="btn btn-sm btn-outline-secondary rounded-3">
            Edit
        </a>

        <a href="/Animals/Delete/${Id}"
           class="btn btn-sm btn-outline-danger rounded-3">
            Delete
        </a>

    </div>

</script>