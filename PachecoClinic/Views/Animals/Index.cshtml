@model IEnumerable<PachecoClinic.Models.AnimalListViewModel>

@{
    ViewData["Title"] = "Animals";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="mb-0">
        Animals
    </h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Create Animal
    </a>

</div>

<ejs-grid id="AnimalsGrid"
          dataSource="@Model"
          allowSorting="true"
          allowFiltering="true"
          allowPaging="true">

    <e-grid-filtersettings type="Menu">
    </e-grid-filtersettings>

    <e-grid-pagesettings pageSize="10">
    </e-grid-pagesettings>

    <e-grid-columns>

        <e-grid-column field="Name"
                       headerText="Name"
                       width="130">
        </e-grid-column>

        <e-grid-column field="Species"
                       headerText="Species"
                       width="130">
        </e-grid-column>

        <e-grid-column field="Breed"
                       headerText="Breed"
                       width="140">
        </e-grid-column>

        <e-grid-column field="Owner"
                       headerText="Owner"
                       width="190">
        </e-grid-column>

        <e-grid-column field="BirthDate"
                       headerText="Birth Date"
                       type="date"
                       format="dd/MM/yyyy"
                       width="130">
        </e-grid-column>

        <e-grid-column field="Weight"
                       headerText="Weight"
                       format="N2"
                       textAlign="Right"
                       width="100">
        </e-grid-column>

        <e-grid-column headerText="Actions"
                       template="#actionsTemplate"
                       allowFiltering="false"
                       allowSorting="false"
                       textAlign="Center"
                       width="230">
        </e-grid-column>

    </e-grid-columns>

</ejs-grid>


<script id="actionsTemplate"
        type="text/x-template">

    <a href="/Animals/Details/${Id}"
       class="btn btn-sm btn-outline-primary">
        Details
    </a>

    <a href="/Animals/Edit/${Id}"
       class="btn btn-sm btn-outline-secondary">
        Edit
    </a>

    <a href="/Animals/Delete/${Id}"
       class="btn btn-sm btn-outline-danger">
        Delete
    </a>

</script>