@model PachecoClinic.Data.Entities.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <h2>Delete Client</h2>

                    <p class="text-danger mb-0">
                        Are you sure you want to delete this client?
                    </p>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <dl class="row">

                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.User.FullName
                    </dd>

                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.User.Email
                    </dd>

                    <dt class="col-sm-4">
                        Phone Number
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "-" : Model.User.PhoneNumber)
                    </dd>

                    <dt class="col-sm-4">
                        NIF
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Nif) ? "-" : Model.Nif)
                    </dd>

                    <dt class="col-sm-4">
                        Address
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)
                    </dd>

                </dl>

                <hr />

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Client
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>