@model PachecoClinic.Data.Entities.Client

@{
    ViewData["Title"] = "Client Details";
}

<h1>Details</h1>

<h4>Client</h4>
<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.User.FullName
    </dd>

    <dt class="col-sm-2">
        Email
    </dt>

    <dd class="col-sm-10">
        @Model.User.Email
    </dd>

    <dt class="col-sm-2">
        Phone Number
    </dt>

    <dd class="col-sm-10">
        @Model.User.PhoneNumber
    </dd>

    <dt class="col-sm-2">
        NIF
    </dt>

    <dd class="col-sm-10">
        @Model.Nif
    </dd>

    <dt class="col-sm-2">
        Address
    </dt>

    <dd class="col-sm-10">
        @Model.Address
    </dd>

</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id">Edit</a>

    <span> | </span>

    <a asp-action="Index">Back to List</a>
</div>
