@model IEnumerable<PachecoClinic.Data.Entities.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="mb-0">
        Clients
    </h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Create Client
        </a>
    }

</div>


<div class="card shadow-sm">
    <div class="card-body p-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>NIF</th>
                        <th>Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.User.FullName
                                </strong>
                            </td>

                            <td>
                                @item.User.Email
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.User.PhoneNumber) ? "-" : item.User.PhoneNumber)
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.Nif) ? "-" : item.Nif)
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.Address) ? "-" : item.Address)
                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>