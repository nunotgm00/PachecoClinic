@using PachecoClinic.Data.Entities
@model PachecoClinic.Data.Entities.AppointmentRequest

@{
    ViewData["Title"] = "Appointment Request Details";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1"
                        style="color: var(--clinic-primary);">
                        Appointment Request Details
                    </h2>

                    <p class="text-muted mb-0">
                        Review the details of this appointment request.
                    </p>
                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-4 fw-semibold">
                        Client
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Animal.Client.User.FullName
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Animal
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Animal.Name
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Doctor
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Doctor.User.FullName
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Current Date
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Date.ToString("dd/MM/yyyy")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Current Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.StartTime.ToString(@"hh\:mm")
                        -
                        @Model.Appointment.EndTime.ToString(@"hh\:mm")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Request Type
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Type
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Requested Date
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.RequestedDate.HasValue? Model.RequestedDate.Value.ToString("dd/MM/yyyy") : "-")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Requested Time
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.RequestedStartTime.HasValue? Model.RequestedStartTime.Value.ToString(@"hh\:mm") : "-")
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Message
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Message) ? "-" : Model.Message)
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Status
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Status == AppointmentRequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == AppointmentRequestStatus.Approved)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Created At
                    </dt>

                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                </dl>

                @if (Model.Status == AppointmentRequestStatus.Pending && !User.IsInRole("Client"))
                {
                    <hr class="my-4" />

                    <div class="d-flex gap-2">

                        <form asp-action="Approve"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success px-4 rounded-3">
                                <i class="bi bi-check-circle me-1"></i>
                                Approve
                            </button>

                        </form>

                        <form asp-action="Reject"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger px-4 rounded-3">
                                <i class="bi bi-x-circle me-1"></i>
                                Reject
                            </button>

                        </form>

                    </div>
                }

                <hr class="my-4" />

                @if (User.IsInRole("Client"))
                {
                    <a asp-action="MyRequests"
                       class="btn btn-outline-secondary rounded-3">
                        Back to My Requests
                    </a>
                }
                else
                {
                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-3">
                        Back to List
                    </a>
                }

            </div>
        </div>

    </div>
</div>