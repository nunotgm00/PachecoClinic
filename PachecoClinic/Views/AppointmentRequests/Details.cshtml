@using PachecoClinic.Data.Entities
@model PachecoClinic.Data.Entities.AppointmentRequest

@{
    ViewData["Title"] = "Appointment Request Details";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">
                    Appointment Request Details
                </h2>

                <dl class="row">

                    <dt class="col-sm-4">
                        Client
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Animal.Client.User.FullName
                    </dd>


                    <dt class="col-sm-4">
                        Animal
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Animal.Name
                    </dd>


                    <dt class="col-sm-4">
                        Doctor
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Doctor.User.FullName
                    </dd>


                    <dt class="col-sm-4">
                        Current Date
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.Date.ToString("dd/MM/yyyy")
                    </dd>


                    <dt class="col-sm-4">
                        Current Time
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Appointment.StartTime.ToString(@"hh\:mm")
                        -
                        @Model.Appointment.EndTime.ToString(@"hh\:mm")
                    </dd>


                    <dt class="col-sm-4">
                        Request Type
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Type
                    </dd>


                    <dt class="col-sm-4">
                        Requested Date
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.RequestedDate.HasValue ? Model.RequestedDate.Value.ToString("dd/MM/yyyy") : "-")
                    </dd>


                    <dt class="col-sm-4">
                        Requested Time
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.RequestedStartTime.HasValue ? Model.RequestedStartTime.Value.ToString(@"hh\:mm") : "-")
                    </dd>


                    <dt class="col-sm-4">
                        Message
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Message) ? "-" : Model.Message)
                    </dd>


                    <dt class="col-sm-4">
                        Status
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Status == AppointmentRequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == AppointmentRequestStatus.Approved)
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }

                    </dd>


                    <dt class="col-sm-4">
                        Created At
                    </dt>

                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                </dl>


                @if (Model.Status == AppointmentRequestStatus.Pending && !User.IsInRole("Client"))
                {
                    <hr />

                    <div class="d-flex gap-2 mb-3">

                        <form asp-action="Approve"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success">
                                Approve
                            </button>

                        </form>


                        <form asp-action="Reject"
                              asp-route-id="@Model.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger">
                                Reject
                            </button>

                        </form>

                    </div>
                }


                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to List
                </a>

            </div>
        </div>

    </div>
</div>