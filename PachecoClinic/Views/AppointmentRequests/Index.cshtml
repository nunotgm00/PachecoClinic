@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.AppointmentRequest>

@{
    ViewData["Title"] = "Appointment Requests";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-12">

        <div class="d-flex justify-content-between align-items-end mb-4">

            <div>
                <h2 class="fw-bold mb-1"
                    style="color: var(--clinic-primary);">
                    Appointment Requests
                </h2>

                <p class="text-muted mb-0">
                    Review appointment cancellation and reschedule requests.
                </p>
            </div>

            <div class="d-flex gap-2">

                <button type="button"
                        id="pendingOnlyButton"
                        class="btn btn-primary rounded-3">
                    Pending Only
                </button>

                <button type="button"
                        id="showAllButton"
                        class="btn btn-outline-secondary rounded-3">
                    Show All
                </button>

            </div>

        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4">

                <div class="table-responsive rounded-3 border">

                    <table class="table table-hover table-striped align-middle mb-0"
                           style="--bs-table-striped-bg: #eef4f4;">

                        <thead class="table-light">
                            <tr>
                                <th>Client</th>
                                <th>Animal</th>
                                <th>Doctor</th>
                                <th>Appointment</th>
                                <th>Request Type</th>
                                <th>Requested Date</th>
                                <th>Requested Time</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr data-status="@item.Status">

                                    <td>
                                        <strong>
                                            @item.Appointment.Animal.Client.User.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @item.Appointment.Animal.Name
                                    </td>

                                    <td>
                                        @item.Appointment.Doctor.User.FullName
                                    </td>

                                    <td>
                                        @item.Appointment.Date.ToString("dd/MM/yyyy")
                                        <br />

                                        <span class="text-muted">
                                            @item.Appointment.StartTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @item.Type
                                    </td>

                                    <td>
                                        @(item.RequestedDate.HasValue? item.RequestedDate.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>

                                    <td>
                                        @(item.RequestedStartTime.HasValue? item.RequestedStartTime.Value.ToString(@"hh\:mm") : "-")
                                    </td>

                                    <td>

                                        @if (item.Status == AppointmentRequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (item.Status == AppointmentRequestStatus.Approved)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3">
                                            Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const pendingOnlyButton = document.getElementById("pendingOnlyButton");
        const showAllButton = document.getElementById("showAllButton");
        const rows = document.querySelectorAll("tbody tr[data-status]");

        pendingOnlyButton.addEventListener("click", function () {

            rows.forEach(function (row) {

                if (row.dataset.status === "Pending") {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }

            });

        });

        showAllButton.addEventListener("click", function () {

            rows.forEach(function (row) {
                row.style.display = "";
            });

        });

    });
</script>