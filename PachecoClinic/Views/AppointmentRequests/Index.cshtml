@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.AppointmentRequest>

@{
    ViewData["Title"] = "Appointment Requests";
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">
                    Appointment Requests
                </h2>

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Client</th>
                                <th>Animal</th>
                                <th>Doctor</th>
                                <th>Appointment</th>
                                <th>Request Type</th>
                                <th>Requested Date</th>
                                <th>Requested Time</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Appointment.Animal.Client.User.FullName
                                    </td>

                                    <td>
                                        @item.Appointment.Animal.Name
                                    </td>

                                    <td>
                                        @item.Appointment.Doctor.User.FullName
                                    </td>

                                    <td>
                                        @item.Appointment.Date.ToString("dd/MM/yyyy")
                                        <br />
                                        <span class="text-muted">
                                            @item.Appointment.StartTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @item.Type
                                    </td>

                                    <td>
                                        @(item.RequestedDate.HasValue ? item.RequestedDate.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>

                                    <td>
                                        @(item.RequestedStartTime.HasValue ? item.RequestedStartTime.Value.ToString(@"hh\:mm") : "-")
                                    </td>

                                    <td>

                                    @if (item.Status == AppointmentRequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (item.Status == AppointmentRequestStatus.Approved)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

    </div>
</div>