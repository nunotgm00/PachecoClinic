@using PachecoClinic.Data.Entities
@model PachecoClinic.Models.CreateRequestAppointmentViewModel

@{
    ViewData["Title"] = "Create Appointment Request";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-2">Create Appointment Request</h2>

                <p class="text-muted mb-4">
                    Request a cancellation or a change to your appointment.
                </p>

                <form asp-action="Create"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="AppointmentId" />


                    <div class="mb-3">

                        <label asp-for="Type"
                               class="form-label">
                            Request Type
                        </label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<AppointmentRequestType>()"
                                class="form-select">

                            <option value="">
                                Select request type
                            </option>

                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="RequestedDate"
                               class="form-label">
                            Requested Date
                        </label>

                        <input asp-for="RequestedDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="RequestedDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="RequestedStartTime"
                               class="form-label">
                            Requested Start Time
                        </label>

                        <input asp-for="RequestedStartTime"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="RequestedStartTime"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Message"
                               class="form-label">
                            Message
                        </label>

                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Message"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Submit Request
                        </button>

                        <a asp-action="MyRequests"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}