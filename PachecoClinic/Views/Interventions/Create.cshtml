@model PachecoClinic.Models.CreateInterventionViewModel

@{
    ViewData["Title"] = "Create Intervention";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-4">Create Intervention</h2>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="AppointmentId" />


                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the intervention performed...">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Diagnosis"
                               class="form-label">
                            Diagnosis
                        </label>

                        <textarea asp-for="Diagnosis"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter the diagnosis...">
                        </textarea>

                        <span asp-validation-for="Diagnosis"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Treatment"
                               class="form-label">
                            Treatment
                        </label>

                        <textarea asp-for="Treatment"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter the prescribed treatment...">
                        </textarea>

                        <span asp-validation-for="Treatment"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Observations"
                               class="form-label">
                            Observations
                        </label>

                        <textarea asp-for="Observations"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Additional observations...">
                        </textarea>

                        <span asp-validation-for="Observations"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Create Intervention
                        </button>

                        <a asp-controller="Appointments"
                           asp-action="Details"
                           asp-route-id="@Model.AppointmentId"
                           class="btn btn-outline-secondary">
                            Back to Appointment
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}