@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.Intervention>

@{
    ViewData["Title"] = "Interventions";
}

<h1>Interventions</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Animal
            </th>
            <th>
                Owner
            </th>
            <th>
                Doctor
            </th>
            <th>
                Appointment Date
            </th>
            <th>
                Description
            </th>
            <th>
                Diagnosis
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (Intervention item in Model)
        {
            <tr>
                <td>
                    @item.Appointment.Animal.Name
                </td>
                <td>
                    @item.Appointment.Animal.Client.User.FullName
                </td>
                <td>
                    @item.Appointment.Doctor.User.FullName
                </td>
                <td>
                    @item.Appointment.Date.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.Diagnosis
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
