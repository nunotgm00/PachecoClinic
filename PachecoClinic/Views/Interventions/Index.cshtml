@using PachecoClinic.Data.Entities
@model IEnumerable<PachecoClinic.Data.Entities.Intervention>

@{
    ViewData["Title"] = "Interventions";
}

<div class="mb-4">

    <h1 class="fw-bold mb-1"
        style="color: var(--clinic-primary);">
        Interventions
    </h1>

    <p class="text-muted mb-0">
        View the clinic's recorded medical interventions.
    </p>

</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5"
     style="border-top: 5px solid var(--clinic-primary) !important;">

    <div class="card-body p-4">

        <div class="table-responsive rounded-3 border">

            <table class="table table-hover table-striped align-middle mb-0"
                   style="--bs-table-striped-bg: #eef4f4;">

                <thead class="table-light">

                    <tr>
                        <th>Animal</th>
                        <th>Owner</th>
                        <th>Doctor</th>
                        <th>Appointment Date</th>
                        <th>Description</th>
                        <th>Diagnosis</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (Intervention item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @item.Appointment.Animal.Name
                            </td>

                            <td>
                                @item.Appointment.Animal.Client.User.FullName
                            </td>

                            <td>
                                @item.Appointment.Doctor.User.FullName
                            </td>

                            <td class="text-nowrap">
                                @item.Appointment.Date.ToString("dd/MM/yyyy")
                            </td>

                            <td style="max-width: 220px;">

                                <span class="d-block text-truncate"
                                      style="max-width: 200px;"
                                      title="@item.Description">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                </span>

                            </td>

                            <td style="max-width: 220px;">

                                <span class="d-block text-truncate"
                                      style="max-width: 200px;"
                                      title="@item.Diagnosis">
                                    @(string.IsNullOrWhiteSpace(item.Diagnosis) ? "-" : item.Diagnosis)
                                </span>

                            </td>

                            <td class="text-nowrap">

                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary rounded-3">
                                        Details
                                    </a>

                                    @if (User.IsInRole("Doctor") && item.Appointment.Doctor.User.Email == User.Identity!.Name)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary rounded-3">
                                            Edit
                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No interventions found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>