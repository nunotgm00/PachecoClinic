@model PachecoClinic.Data.Entities.Intervention

@{
    ViewData["Title"] = "Intervention Details";
}

<h1>Details</h1>

<h4>Intervention</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">
        Animal
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.Animal.Name
    </dd>

    <dt class="col-sm-2">
        Owner
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.Animal.Client.User.FullName
    </dd>

    <dt class="col-sm-2">
        Doctor
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.Doctor.User.FullName
    </dd>

    <dt class="col-sm-2">
        Room
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.Room.Name
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.Date.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">
        Start Time
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.StartTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        End Time
    </dt>
    <dd class="col-sm-10">
        @Model.Appointment.EndTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-2">
        Description
    </dt>
    <dd class="col-sm-10">
        @Model.Description
    </dd>

    <dt class="col-sm-2">
        Diagnosis
    </dt>
    <dd class="col-sm-10">
        @Model.Diagnosis
    </dd>

    <dt class="col-sm-2">
        Treatment
    </dt>
    <dd class="col-sm-10">
        @Model.Treatment
    </dd>

    <dt class="col-sm-2">
        Observations
    </dt>
    <dd class="col-sm-10">
        @Model.Observations
    </dd>
</dl>

<div>
    @if(User.IsInRole("Doctor") && Model.Appointment.Doctor.User.Email == User.Identity!.Name)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>
    }

    @if (User.IsInRole("Client"))
    {
        <a asp-controller="Animals"
           asp-action="History"
           asp-route-id="@Model.Appointment.AnimalId"
           class="btn btn-secondary">
            Back to Medical History
        </a>
    }
    else
    {
        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>
    }
</div>
