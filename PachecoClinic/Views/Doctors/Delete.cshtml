@model PachecoClinic.Data.Entities.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="row justify-content-center mb-5">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.User.ImageUrl))
                    {
                        <img src="@Model.User.ImageUrl"
                             alt="@Model.User.FullName"
                             class="rounded-circle shadow-sm mb-3"
                             style="width: 120px; height: 120px; object-fit: cover;" />
                    }

                    <h2 class="fw-bold mb-2"
                        style="color: var(--clinic-primary);">
                        Delete Doctor
                    </h2>

                    <p class="text-danger mb-0">
                        Are you sure you want to delete this doctor?
                    </p>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <dl class="row mb-0">

                    <dt class="col-sm-4 fw-semibold">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.User.FullName
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Email
                    </dt>

                    <dd class="col-sm-8 text-break">
                        @Model.User.Email
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Specialty
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Specialty.Name
                    </dd>

                    <dt class="col-sm-4 fw-semibold">
                        Status
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Active)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }

                    </dd>

                </dl>

                <hr class="my-4" />

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger px-4 rounded-3">
                            <i class="bi bi-trash me-1"></i>
                            Delete Doctor
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary px-4 rounded-3">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>