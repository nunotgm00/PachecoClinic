@model PachecoClinic.Models.CreateDoctorViewModel

@{
    ViewData["Title"] = "Create Doctor";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-2">Create Doctor</h2>

                <p class="text-muted mb-4">
                    Create the doctor's account and assign a specialty.
                    The doctor will receive an email to complete the registration.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="doctor@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SpecialtyId"
                               class="form-label">
                            Specialty
                        </label>

                        <select asp-for="SpecialtyId"
                                asp-items="Model.Specialties"
                                class="form-select">

                            <option value="">
                                Select a specialty
                            </option>

                        </select>

                        <span asp-validation-for="SpecialtyId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Create Doctor
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}