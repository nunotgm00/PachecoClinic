@model IEnumerable<PachecoClinic.Models.DoctorListViewModel>

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Doctors</h1>

        <p class="text-muted mb-0">
            View the clinic's medical team.
        </p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Create Doctor
        </a>
    }

</div>

<ejs-grid id="DoctorsGrid"
          dataSource="@Model"
          allowSorting="true"
          allowFiltering="true"
          allowPaging="true">

    <e-grid-filtersettings type="Menu">
    </e-grid-filtersettings>

    <e-grid-pagesettings pageSize="10">
    </e-grid-pagesettings>

    <e-grid-columns>

        <e-grid-column field="Name"
                       headerText="Name"
                       width="180">
        </e-grid-column>

        <e-grid-column field="Email"
                       headerText="Email"
                       width="220">
        </e-grid-column>

        <e-grid-column field="PhoneNumber"
                       headerText="Phone Number"
                       width="150">
        </e-grid-column>

        <e-grid-column field="Specialty"
                       headerText="Specialty"
                       width="160">
        </e-grid-column>

        <e-grid-column field="Active"
                       headerText="Active"
                       displayAsCheckBox="true"
                       textAlign="Center"
                       width="100">
        </e-grid-column>

        <e-grid-column headerText="Actions"
                       template="#actionsTemplate"
                       allowFiltering="false"
                       allowSorting="false"
                       textAlign="Center"
                       width="240">
        </e-grid-column>

    </e-grid-columns>

</ejs-grid>

<script id="actionsTemplate"
        type="text/x-template">

    <a href="/Doctors/Details/${Id}"
       class="btn btn-sm btn-outline-primary">
        Details
    </a>

    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
            <a href="/Doctors/Edit/${Id}"
               class="btn btn-sm btn-outline-secondary">
                Edit
            </a>

            <a href="/Doctors/Delete/${Id}"
               class="btn btn-sm btn-outline-danger">
                Delete
            </a>
    }

</script>