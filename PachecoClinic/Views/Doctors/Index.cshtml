@model IEnumerable<PachecoClinic.Data.Entities.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Specialty</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.User.FullName
                </td>

                <td>
                    @item.User.Email
                </td>

                <td>
                    @item.User.PhoneNumber
                </td>

                <td>
                    @item.Specialty.Name
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Active)
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
