@model IEnumerable<PachecoClinic.Models.DoctorListViewModel>

@{
    ViewData["Title"] = "Doctors";
}

<style>
    #DoctorsGrid .e-headercell {
        position: relative;
    }

        #DoctorsGrid .e-headercell .e-filtermenudiv {
            position: absolute !important;
            left: 10px !important;
            right: auto !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        #DoctorsGrid .e-headercell:has(.e-filtermenudiv) .e-headercelldiv {
            padding-left: 28px !important;
            margin: 0 !important;
        }

    #DoctorsGrid .e-row:nth-child(even) .e-rowcell {
        background-color: #eef4f4;
    }

    #DoctorsGrid .e-row:hover .e-rowcell {
        background-color: #e3eeee;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1"
            style="color: var(--clinic-primary);">
            Doctors
        </h1>

        <p class="text-muted mb-0">
            View the clinic's medical team.
        </p>

    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
    {
        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary rounded-3 px-3">
            <i class="bi bi-person-plus me-1"></i>
            Create User
        </a>
    }

</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5"
     style="border-top: 5px solid var(--clinic-primary) !important;">

    <div class="card-body p-3">

        <ejs-grid id="DoctorsGrid"
                  dataSource="@Model"
                  allowSorting="true"
                  allowFiltering="true"
                  allowPaging="true">

            <e-grid-filtersettings type="Menu">
            </e-grid-filtersettings>

            <e-grid-pagesettings pageSize="10">
            </e-grid-pagesettings>

            <e-grid-columns>

                <e-grid-column field="Name"
                               headerText="Name"
                               width="180">
                </e-grid-column>

                <e-grid-column field="Email"
                               headerText="Email"
                               width="220">
                </e-grid-column>

                <e-grid-column field="PhoneNumber"
                               headerText="Phone Number"
                               width="150">
                </e-grid-column>

                <e-grid-column field="Specialty"
                               headerText="Specialty"
                               width="160">
                </e-grid-column>

                <e-grid-column field="Active"
                               headerText="Active"
                               displayAsCheckBox="true"
                               textAlign="Center"
                               width="100">
                </e-grid-column>

                <e-grid-column headerText="Actions"
                               template="#actionsTemplate"
                               allowFiltering="false"
                               allowSorting="false"
                               textAlign="Center"
                               width="240">
                </e-grid-column>

            </e-grid-columns>

        </ejs-grid>

    </div>

</div>

<script id="actionsTemplate"
        type="text/x-template">

    <div class="d-flex justify-content-center gap-2">

        <a href="/Doctors/Details/${Id}"
           class="btn btn-sm btn-outline-primary rounded-3">
            Details
        </a>

        @if (User.IsInRole("Admin"))
        {
                <a href="/Doctors/Edit/${Id}"
                   class="btn btn-sm btn-outline-secondary rounded-3">
                    Edit
                </a>

                <a href="/Doctors/Delete/${Id}"
                   class="btn btn-sm btn-outline-danger rounded-3">
                    Delete
                </a>
        }

    </div>

</script>