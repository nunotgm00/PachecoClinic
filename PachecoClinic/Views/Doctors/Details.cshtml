@using PachecoClinic.Data.Entities
@using PachecoClinic.Models
@model Doctor

@{
    ViewData["Title"] = "Doctor Details";

    DateTime currentDate = DateTime.Today;

    List<DoctorAppointmentScheduleViewModel> scheduleData =
        ViewBag.ScheduleData ?? new List<DoctorAppointmentScheduleViewModel>();

    bool canManageSchedule =
        User.IsInRole("Admin") ||
        User.IsInRole("Employee") ||
        (User.IsInRole("Doctor") && Model.User.Email == User.Identity!.Name);
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-10">

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4"
             style="border-top: 5px solid var(--clinic-primary) !important;">

            <div class="card-body p-4 p-md-5">

                <div class="row align-items-center">

                    <div class="col-md-3 text-center mb-3 mb-md-0">

                        @if (!string.IsNullOrEmpty(Model.User.ImageUrl))
                        {
                            <img src="@Model.User.ImageUrl"
                                 alt="@Model.User.FullName"
                                 class="rounded-circle shadow-sm"
                                 style="width: 160px; height: 160px; object-fit: cover;" />
                        }

                    </div>

                    <div class="col-md-9">

                        <h2 class="fw-bold mb-1"
                            style="color: var(--clinic-primary);">
                            @Model.User.FullName
                        </h2>

                        <h5 class="text-muted mb-3">
                            @Model.Specialty.Name
                        </h5>

                        <dl class="row mb-0">

                            <dt class="col-sm-3 fw-semibold">
                                Email
                            </dt>

                            <dd class="col-sm-9 text-break">
                                @Model.User.Email
                            </dd>

                            <dt class="col-sm-3 fw-semibold">
                                Phone Number
                            </dt>

                            <dd class="col-sm-9">
                                @(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "-" : Model.User.PhoneNumber)
                            </dd>

                            <dt class="col-sm-3 fw-semibold">
                                Status
                            </dt>

                            <dd class="col-sm-9">

                                @if (Model.Active)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </dd>

                        </dl>

                    </div>

                </div>

                @if (canManageSchedule)
                {
                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="DoctorSchedules"
                           asp-action="Manage"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary rounded-3">
                            <i class="bi bi-calendar-week me-1"></i>
                            Manage Schedule
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-primary rounded-3">
                                Edit Doctor
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-danger rounded-3">
                                Delete Doctor
                            </a>
                        }

                    </div>
                }

            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Employee") || User.IsInRole("Doctor"))
        {
            <div class="card shadow-sm border-0 rounded-4 mb-4"
                 style="border-top: 5px solid var(--clinic-primary) !important;">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <h3 class="fw-bold mb-1"
                            style="color: var(--clinic-primary);">
                            Appointments
                        </h3>

                        <p class="text-muted mb-0">
                            View the doctor's scheduled appointments.
                        </p>

                    </div>

                    <div class="row">

                        <div class="col-md-4 mb-4 mb-md-0">

                            <ejs-calendar id="doctor-calendar"
                                          value="@currentDate"
                                          change="currentDateChange">
                            </ejs-calendar>

                        </div>

                        <div class="col-md-8">

                            <ejs-schedule id="doctor-schedule"
                                          selectedDate="@currentDate"
                                          height="650px"
                                          readonly="true">

                                <e-schedule-views>
                                    <e-schedule-view option="Day"></e-schedule-view>
                                    <e-schedule-view option="Week"></e-schedule-view>
                                    <e-schedule-view option="Month"></e-schedule-view>
                                </e-schedule-views>

                                <e-schedule-eventsettings dataSource="@scheduleData">
                                </e-schedule-eventsettings>

                            </ejs-schedule>

                        </div>

                    </div>

                </div>
            </div>
        }

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-4">
            Back to Doctors
        </a>

    </div>
</div>

<script>

    function currentDateChange(args) {

        if (args && args.isInteracted) {

            var schedule =
                document.getElementById("doctor-schedule");

            if (schedule) {
                schedule.ej2_instances[0].selectedDate = args.value;
            }
        }
    }

</script>