@model PachecoClinic.Data.Entities.Doctor

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Doctor</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.User.FullName
        </dd>

        <dt class="col-sm-2">
            Email
        </dt>

        <dd class="col-sm-10">
            @Model.User.Email
        </dd>

        <dt class="col-sm-2">
            Phone Number
        </dt>

        <dd class="col-sm-10">
            @Model.User.PhoneNumber
        </dd>

        <dt class="col-sm-2">
            Specialty
        </dt>

        <dd class="col-sm-10">
            @Model.Specialty.Name
        </dd>

        <dt class="col-sm-2">
            Active
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Active)
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id">Edit</a> |

    <a asp-action="Index">Back to List</a>
</div>
