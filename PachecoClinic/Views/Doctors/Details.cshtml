@using PachecoClinic.Data.Entities
@using PachecoClinic.Models
@model PachecoClinic.Data.Entities.Doctor

@{
    ViewData["Title"] = "Doctor Details";

    DateTime currentDate = DateTime.Today;

    List<DoctorAppointmentScheduleViewModel> scheduleData =
        ViewBag.ScheduleData;
}

<div class="container">

    <div class="row mb-4">

        <div class="col-md-2">

            @if (!string.IsNullOrEmpty(Model.User.ImageUrl))
            {
                <img src="@Model.User.ImageUrl"
                     alt="@Model.User.FullName"
                     class="img-fluid rounded-circle"
                     style="width: 140px; height: 140px; object-fit: cover;" />
            }

        </div>

        <div class="col-md-7">

            <h2>@Model.User.FullName</h2>

            <p class="mb-1">
                <strong>Specialty:</strong>
                @Model.Specialty.Name
            </p>

            <p class="mb-1">
                <strong>Email:</strong>
                @Model.User.Email
            </p>

            <p class="mb-1">
                <strong>Phone:</strong>
                @Model.User.PhoneNumber
            </p>

            <p>
                <strong>Status:</strong>

                @if (Model.Active)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </p>

        </div>

        <div class="col-md-3 text-end">

            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <a asp-controller="DoctorSchedules"
                   asp-action="Index"
                   asp-route-doctorId="@Model.Id"
                   class="btn btn-outline-primary">
                    Manage Schedule
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit
                </a>
            }

        </div>

    </div>


    <hr />


    <div class="row">

        <div class="col-md-4">

            <ejs-calendar id="doctor-calendar"
                          value="@currentDate"
                          change="currentDateChange"
                          cssClass="doctor-calendar">
            </ejs-calendar>

        </div>


        <div class="col-md-8">

            <script id="quickInfoFooter" type="text/x-template">
                <div></div>
            </script>

            <ejs-schedule id="doctor-schedule"
                          selectedDate="@currentDate"
                          height="650px"
                          readonly="true">

                <e-schedule-quickinfotemplates footer="#quickInfoFooter">
                </e-schedule-quickinfotemplates>

                <e-schedule-views>
                    <e-schedule-view option="Day"></e-schedule-view>
                    <e-schedule-view option="Week"></e-schedule-view>
                    <e-schedule-view option="Month"></e-schedule-view>
                </e-schedule-views>

                <e-schedule-eventsettings dataSource="@scheduleData">
                </e-schedule-eventsettings>

            </ejs-schedule>

        </div>

    </div>


    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>

</div>


<script>

    function currentDateChange(args) {

        if (args && args.isInteracted) {

            var schedule =
                document.getElementById("doctor-schedule")
                    .ej2_instances[0];

            schedule.selectedDate = args.value;
        }
    }

</script>


<style>

    .doctor-calendar.e-calendar {
        width: 100% !important;
        max-width: 400px !important;
    }

</style>